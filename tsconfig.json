{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"],
    "paths": { "json-fit": ["./src/index.ts"] },
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "test", "examples"]
}
